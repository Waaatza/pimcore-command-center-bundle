{
  "name": "watza/command-center-bundle",
  "type": "pimcore-bundle",
  "license": "MIT",
  "description": "Run and schedule Symfony console commands and PHP scripts from Pimcore Studio.",
  "homepage": "https://github.com/Waaatza/pimcore-command-center-bundle",
  "keywords": [
    "pimcore",
    "pimcore-studio",
    "commands",
    "scheduler"
  ],
  "require": {
    "php": "^8.3",
    "pimcore/pimcore": "^12.3 || ^2026.1",
    "pimcore/studio-backend-bundle": "^2025.4 || ^2026.1",
    "pimcore/studio-ui-bundle": "^2025.4 || ^2026.1",
    "symfony/process": "^6.4 || ^7.0",
    "symfony/scheduler": "^6.4 || ^7.0",
    "symfony/messenger": "^6.4 || ^7.0",
    "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Watza\\CommandCenterBundle\\": "src/"
    }
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Watza\\CommandCenterBundle\\PimcoreCommandCenterBundle"
      ]
    }
  },
  "scripts": {
    "test": [
      "@php tests/CommandCenter/smoke.php",
      "@php tests/CommandCenter/schedules.php",
      "@php tests/CommandCenter/parameters.php",
      "@php tests/CommandCenter/notifications.php",
      "@php tests/CommandCenter/editing.php",
      "@php tests/CommandCenter/history.php",
      "@php tests/CommandCenter/templates.php",
      "@php tests/CommandCenter/workflows.php",
      "@php tests/CommandCenter/terminal.php",
      "@php tests/CommandCenter/studio-actions.php"
    ]
  }
}
